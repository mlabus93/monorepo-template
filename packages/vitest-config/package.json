{
  "name": "@repo/vitest-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    }
  },
  "scripts": {
    "report": "node scripts/merge-blob-reports.mjs && vitest run --root ../.. --merge-reports coverage/merged-blob --passWithNoTests --coverage --coverage.provider=v8 --coverage.reporter=html --coverage.reporter=text --coverage.reportsDirectory=packages/vitest-config/coverage/report"
  },
  "dependencies": {
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:"
  }
}
