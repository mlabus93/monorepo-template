{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".node-version", "pnpm-workspace.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!e2e/**",
        "!playwright.config.ts"
      ],
      "env": ["VITE_*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "check-types": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!e2e/**",
        "!playwright.config.ts",
        "!tsconfig.e2e.json"
      ],
      "outputs": ["coverage/blob/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "env": ["CI", "PLAYWRIGHT_BASE_URL"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"],
      "cache": false
    },
    "test:e2e:ui": {
      "dependsOn": ["build"],
      "env": ["CI", "PLAYWRIGHT_BASE_URL"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"],
      "cache": false,
      "persistent": true
    },
    "test:e2e:headed": {
      "dependsOn": ["build"],
      "env": ["CI", "PLAYWRIGHT_BASE_URL"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"],
      "cache": false
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
