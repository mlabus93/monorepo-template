{
  "name": "monorepo-template",
  "description": "Reusable React, Vite, and Turborepo project template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "check-types": "turbo run check-types",
    "pretest": "node packages/vitest-config/scripts/clean-blob-reports.js",
    "test": "turbo run test",
    "test:projects": "vitest run",
    "test:projects:watch": "vitest --watch",
    "report": "pnpm test && pnpm --filter @repo/vitest-config report",
    "prepare": "husky",
    "lint-staged": "lint-staged --cwd=.",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm check-types && pnpm build && pnpm report"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "jsdom": "catalog:",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@repo/eslint-config": "workspace:*"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@12.1.0"
}
